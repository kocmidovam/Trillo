{
  "name": "trillo",
  "version": "1.0.0",
  "description": "Responsive hotel booking UI concept built with Sass and Flexbox",
  "homepage": "https://kocmidovam.github.io/Trillo/",
  "scripts": {
    "watch:sass": "sass --watch sass/main.scss:css/style.css --no-source-map",
    "serve": "serve .",
    "start": "concurrently \"npm:serve\" \"npm:watch:sass\"",
    "compile:sass": "sass sass/main.scss css/style.comp.css --style=expanded --no-source-map",
    "prefix:css": "postcss css/style.comp.css --use autoprefixer -o css/style.prefix.css",
    "compress:css": "sass css/style.prefix.css css/style.css --style=compressed --no-source-map",
    "build:css": "npm run compile:sass && npm run prefix:css && npm run compress:css"
  },
  "author": "Marta Kocmidova",
  "license": "MIT",
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "not dead"
  ],
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "sass": "1.89.2",
    "serve": "^14.2.4"
  }
}
